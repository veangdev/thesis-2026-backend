# Application
NODE_ENV=development
PORT=8000
APP_PREFIX=api/v1

# Database
# Local (host) connects to the Postgres container published on 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pnc_journey_star?schema=public"

# JWT — use long, random values in real environments (min 16 chars each)
JWT_SECRET=change-me-access-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS — frontend dev server origin (comma-separated to allow several)
CORS_ORIGIN=http://localhost:3000

# Mail — leave SMTP_HOST empty to use an Ethereal test account in development
# (nothing is delivered; a preview URL is logged for each message instead).
# For Gmail, SMTP_PASS must be a 16-character App Password, not the account
# password. Never commit real values here — put them in .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="PNC Journey Star <your-account@gmail.com>"

# ── File uploads ──────────────────────────────────────────────────────────
# Where uploaded files are written. Relative paths resolve against the
# process working directory; point it at a mounted volume in production so
# uploads survive a redeploy.
UPLOAD_DIR=uploads
# URL prefix those files are served under.
UPLOAD_PUBLIC_PATH=/uploads
