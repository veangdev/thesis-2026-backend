generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

/// System role keys — must match the frontend contract exactly.
enum Role {
  program_coordinator
  facilitator
  self_assessor
}

/// Lifecycle of an assessment cycle — must match the frontend contract exactly.
/// `active` is the open window students submit into; `completed` is closed.
enum AssessmentPeriodStatus {
  upcoming
  active
  completed
}

/// Self-reported gender, used for roster breakdowns on the Assessments screen.
/// Optional on every user.
enum Gender {
  male
  female
}

/// A cohort (batch) is subdivided into classes A/B/C. Self-assessors only.
enum StudentClass {
  A
  B
  C
}

/// Lifecycle of a cohort — must match the frontend contract exactly.
enum CohortStatus {
  active
  completed
  archived
}

/// Lifecycle of a growth goal — must match the frontend contract exactly.
/// `achieved` is set explicitly rather than derived from `progressPercent`: a
/// student may call a goal done below 100%, and `archived` has no progress
/// equivalent at all.
enum GoalStatus {
  active
  achieved
  archived
}

/// Lifecycle of one assessment cycle — must match the frontend contract exactly.
/// `agreed` is reached explicitly, when the facilitator marks the discussed
/// scores as settled; only from there can the cycle be completed.
enum AssessmentStatus {
  draft
  self_submitted
  mentor_review
  agreed
  completed
}

/// The facilitator's own judgement on a dimension during review — must match the
/// frontend contract exactly. Distinct from `AssessmentScore.coachingRecommended`,
/// which the system derives at completion (§5.5) and analytics counts as a
/// coaching flag. One is an opinion, the other a computed fact; collapsing them
/// would make the coaching rule unwritable.
enum CoachingTag {
  needs_focus
  on_track
  strength
  coaching_recommended
}

enum CoachingScope {
  individual
  group
  class
  batch
}

enum CoachingStatus {
  scheduled
  completed
  cancelled
}

/// Finer-grained than the frontend's notification categories, because mail
/// templating keys off the exact event. `NOTIFICATION_CATEGORY_BY_TYPE` collapses
/// these onto the four categories the Notifications centre filters by.
enum NotificationType {
  assessment_reminder
  coaching_reminder
  achievement
  submission
  goal
  system
}

// ─────────────────────────────── Identity ───────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(self_assessor)
  avatarUrl     String?
  expertiseTags String[] @default([])
  /// Days this facilitator is free to coach, as YYYY-MM-DD.
  availability  String[] @default([])
  isActive      Boolean  @default(true)
  /// Self-reported; not every user has one on file.
  gender        Gender?
  /// Class within the cohort/batch. Self-assessors only.
  studentClass  StudentClass?
  /// Institution-issued student ID, e.g. "2024-ID-05". Self-assessors only.
  studentCode   String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens           RefreshToken[]
  otpCodes                OtpCode[]
  cohortMemberships       CohortMember[]
  facilitatorAssignments  MentorAssignment[]    @relation("FacilitatorAssignments")
  selfAssessorAssignments MentorAssignment[]    @relation("SelfAssessorAssignments")
  assessments             Assessment[]
  coachingSessions        CoachingSession[]     @relation("FacilitatorSessions")
  coachingParticipations  CoachingParticipant[]
  assignedActionItems     ActionItem[]          @relation("ActionItemAssignee")
  goals                   Goal[]
  notifications           Notification[]
  achievements            Achievement[]
  auditLogs               AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// One-time numeric codes emailed to users (password reset, email verification,
/// login, …). The plaintext code is never stored — only a hash — and each code
/// is single-use, expires, and is scoped by `purpose` so one table serves every
/// OTP feature.
model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

// ─────────────────────────────── Cohorts ───────────────────────────────

model Cohort {
  id String @id @default(cuid())
  /// A batch **is** its intake year: always exactly `Batch YYYY`, and unique.
  /// The format is enforced by `CreateCohortDto`/`UpdateCohortDto`, so this
  /// index on the whole name is what makes the *year* unique — without the
  /// format rule, `Batch 2026 — Data Science` and `Batch 2026 — Product Design`
  /// are two distinct names and the index would let both through. Track and
  /// scale live in `description`; they never qualify the name.
  name            String       @unique
  description     String?
  startDate       DateTime
  expectedEndDate DateTime
  scoringScaleMax Int          @default(5) // allow 5 or 10
  status          CohortStatus @default(active)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  members          CohortMember[]
  assignments      MentorAssignment[]
  dimensions       Dimension[]
  periods          AssessmentPeriod[]
  coachingSessions CoachingSession[]

  @@map("cohorts")
}

model CohortMember {
  id       String   @id @default(cuid())
  userId   String
  cohortId String
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([cohortId])
  @@map("cohort_members")
}

model MentorAssignment {
  id             String   @id @default(cuid())
  facilitatorId  String
  selfAssessorId String
  cohortId       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  facilitator  User   @relation("FacilitatorAssignments", fields: [facilitatorId], references: [id], onDelete: Cascade)
  selfAssessor User   @relation("SelfAssessorAssignments", fields: [selfAssessorId], references: [id], onDelete: Cascade)
  cohort       Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([facilitatorId, selfAssessorId, cohortId])
  @@index([facilitatorId])
  @@index([selfAssessorId])
  @@index([cohortId])
  @@map("mentor_assignments")
}

// ─────────────────────────────── Assessments ───────────────────────────────

model Dimension {
  id          String   @id @default(cuid())
  cohortId    String
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cohort           Cohort                     @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  scores           AssessmentScore[]
  goals            Goal[]
  coachingSessions CoachingSessionDimension[]

  @@index([cohortId])
  @@map("dimensions")
}

model AssessmentPeriod {
  id        String                 @id @default(cuid())
  cohortId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    AssessmentPeriodStatus @default(upcoming)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  cohort      Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@index([cohortId])
  @@map("assessment_periods")
}

model Assessment {
  id        String           @id @default(cuid())
  studentId String
  periodId  String
  status    AssessmentStatus @default(draft)

  /// The student's summary of their own cycle, written alongside the per-dimension
  /// reflections and shown to the facilitator during review.
  overallReflection String?
  /// The facilitator's closing summary, shared with the student on completion.
  overallFeedback   String?

  /// When the facilitator marked the discussed scores as agreed.
  mentorSubmittedAt DateTime?
  /// When the cycle was completed. Distinct from `mentorSubmittedAt`: agreeing on
  /// scores and closing the cycle are two steps in the status machine.
  completedAt       DateTime?
  submittedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period  AssessmentPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  scores  AssessmentScore[]

  @@unique([studentId, periodId])
  @@index([studentId])
  @@index([periodId])
  @@map("assessments")
}

model AssessmentScore {
  id                  String  @id @default(cuid())
  assessmentId        String
  dimensionId         String
  selfScore           Int?
  selfReflection      String?
  mentorScore         Int?
  mentorNote          String?
  agreedScore         Int?
  /// Facilitator-authored during review. Nullable: not every dimension gets one.
  coachingTag         CoachingTag?
  /// System-derived at completion by `isCoachingRecommended` (§5.5), and counted
  /// as a coaching flag by analytics. Never written by a client.
  coachingRecommended Boolean      @default(false)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  dimension  Dimension  @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, dimensionId])
  @@index([dimensionId])
  @@map("assessment_scores")
}

// ─────────────────────────────── Coaching ───────────────────────────────

model CoachingSession {
  id              String         @id @default(cuid())
  title           String
  scope           CoachingScope
  facilitatorId   String
  cohortId        String?
  scheduledAt     DateTime
  durationMinutes Int            @default(60)
  notes           String?
  status          CoachingStatus @default(scheduled)
  followUpAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  facilitator      User                       @relation("FacilitatorSessions", fields: [facilitatorId], references: [id], onDelete: Cascade)
  cohort           Cohort?                    @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  participants     CoachingParticipant[]
  targetDimensions CoachingSessionDimension[]
  actionItems      ActionItem[]

  @@index([facilitatorId])
  @@index([cohortId])
  @@index([scheduledAt])
  @@map("coaching_sessions")
}

model CoachingParticipant {
  id        String @id @default(cuid())
  sessionId String
  userId    String

  session CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("coaching_participants")
}

model CoachingSessionDimension {
  id          String @id @default(cuid())
  sessionId   String
  dimensionId String

  session   CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dimension Dimension       @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, dimensionId])
  @@index([dimensionId])
  @@map("coaching_session_dimensions")
}

model ActionItem {
  id          String    @id @default(cuid())
  sessionId   String
  assigneeId  String?
  description String
  dueDate     DateTime?
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  session  CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignee User?           @relation("ActionItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@map("action_items")
}

// ─────────────────────────────── Growth ───────────────────────────────

model Goal {
  id                String    @id @default(cuid())
  studentId         String
  title             String
  description       String?
  targetDimensionId String?
  dueDate           DateTime?
  progressPercent   Int        @default(0)
  /// Score on the cohort's scale the student is aiming for on `targetDimension`.
  targetScore       Int?
  status            GoalStatus @default(active)
  milestones        Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  student         User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetDimension Dimension? @relation(fields: [targetDimensionId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([targetDimensionId])
  @@map("goals")
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType
  title  String
  body   String
  /// In-app destination the notification links to, as a root-relative path
  /// (e.g. `/assessments/abc`). Null when the event has nowhere useful to go.
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

/// Program-wide notification toggles the Program Coordinator controls on the
/// Settings screen.
///
/// Only the *state* lives here — the catalogue of rules (key, label,
/// description) is a backend constant, because the backend is what acts on
/// them when it decides whether to send a mail. A rule with no row yet falls
/// back to the catalogue's default, so adding a rule needs no data migration.
model NotificationRule {
  key       String   @id
  enabled   Boolean
  updatedAt DateTime @updatedAt

  @@map("notification_rules")
}

model Achievement {
  id        String   @id @default(cuid())
  studentId String
  key       String
  title     String
  earnedAt  DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("achievements")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@map("audit_logs")
}
